# composer analyse runs with --memory-limit=2G: each parallel worker loads the WordPress stubs and keeps them for all
# the files it analyses (a single file needs about 0.5 GB)
parameters:
    level: max
    paths:
        - src
        - uninstall.php
    # wp-toolbox.php is not analysed on purpose: its version guard must run on *old* PHP and WordPress
    # versions, which PHPStan (analysing for PHP 8.3+) rightly reports as impossible. It only boots src/.
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    scanFiles:
        - tests/stubs/wp-cli.php
    # optional constants from wp-config.php: may be anything, or not defined at all
    dynamicConstantNames:
        WPTB_SETTINGS: mixed
        WPTB_UPDATE_CHANNEL: mixed

<?xml version="1.0"?>
<ruleset name="wp-toolbox">
	<description>Security-relevant WordPress sniffs. Formatting is left to the editor config.</description>

	<file>src</file>
	<file>wp-toolbox.php</file>
	<file>uninstall.php</file>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="7.1"/>
	<config name="testVersion" value="8.3-"/>

	<rule ref="WordPress.Security">
		<!-- Exceptions here only signal programming errors (duplicate module ids, unknown field keys)
		     and contain identifiers from code, never user input. They are never rendered as HTML. -->
		<exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
	</rule>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<rule ref="WordPress.DB.RestrictedFunctions"/>
	<rule ref="WordPress.WP.DeprecatedFunctions"/>
	<rule ref="WordPress.WP.DeprecatedClasses"/>
	<rule ref="WordPress.WP.DiscouragedFunctions"/>
	<rule ref="WordPress.WP.AlternativeFunctions"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wptb"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
	<rule ref="WordPress.PHP.DevelopmentFunctions"/>
	<rule ref="WordPress.PHP.StrictInArray"/>
	<rule ref="WordPress.PHP.DontExtract"/>
	<rule ref="WordPress.CodeAnalysis.AssignmentInTernaryCondition"/>
	<rule ref="Generic.PHP.Syntax"/>
</ruleset>
